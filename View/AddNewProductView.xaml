<Window x:Class="AutoMarket.View.AddNewProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        Title="{DynamicResource WindowAddingProduct}" 
        Height="600" 
        Width="500"
        FontFamily="{StaticResource CustomFont}"
        Name="AddNewProductWindow">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      Foreground="{DynamicResource MaterialDesignBody}" 
                      Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel Grid.Row="0" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Center" 
                        Orientation="Vertical"
                        Width="400">
                <TextBlock Text="{DynamicResource Category}"/>
                <ComboBox ItemsSource="{Binding AllCategories}" 
                          SelectedItem="{Binding CategoryProduct}"
                          DisplayMemberPath="Name"
                          Margin="0,5"/>

                <TextBlock Text="{DynamicResource ManufacturerHint}"/>
                <ComboBox ItemsSource="{Binding AllManufacturers}" 
                          SelectedItem="{Binding ManufacturerProduct}"
                          DisplayMemberPath="Name"
                          Margin="0,5"/>

                <TextBlock Text="{DynamicResource Name}"/>
                <TextBox Text="{Binding ProductName}" Margin="0,5"/>

                <TextBlock Text="{DynamicResource Quantity}" />
                <TextBox Text="{Binding QuantityProduct, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

                <TextBlock Text="{DynamicResource Price}"/>
                <TextBox Text="{Binding PriceProduct, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

                <TextBlock Text="{DynamicResource Description}"/>
                <TextBox Text="{Binding DescriptionProduct}" 
                         Margin="0,0,0,10"
                         VerticalAlignment="Center"     
                         AcceptsReturn="True" 
                         TextWrapping="Wrap"/>

                <!-- Загрузка изображения -->
                <TextBlock Text="{DynamicResource ProductImage}" 
                           Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" 
                            Margin="0,10,0,0">
                   
                    <Border BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="4"
                            Padding="10"
                            Background="{DynamicResource MaterialDesignPaper}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="{DynamicResource SelectImage}" 
                                    Command="{Binding LoadImageCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="10,5"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    Margin="0,0,0,10"/>

                            <!-- Область предпросмотра -->
                            <Border Grid.Row="1" 
                                    BorderBrush="#DDDDDD" 
                                    BorderThickness="1"
                                    Background="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding ImagePath}" 
                                       MaxWidth="300"
                                       MaxHeight="200"
                                       Stretch="Uniform"/>
                                    
                            </Border>

                            <!-- Заглушка, когда нет изображения -->
                            <TextBlock Grid.Row="1"
                                       Text="{DynamicResource NoImageSelected}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#888888"
                                       FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="{DynamicResource Add_new_product}"
                Command="{Binding AddNewProduct}"
                CommandParameter="{Binding ElementName=AddNewProductWindow}"
                Height="40"
                Foreground="White"
                FontWeight="Bold"
                />
    </Grid>
</Window>
