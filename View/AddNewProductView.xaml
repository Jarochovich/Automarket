<Window x:Class="AutoMarket.View.AddNewProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        Title="AddNewProductView" Height="300" Width="500"
        Name="AddNewProductWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Orientation="Vertical"
                    Width="200">
            <TextBlock Text="Category"></TextBlock>
            <ComboBox ItemsSource="{Binding AllCategories}" 
                      SelectedItem="{Binding CategoryProduct}"
                      DisplayMemberPath="Name"/>
            <TextBlock Text="Product"></TextBlock>
            <TextBox Name="ProductName" Text="{Binding ProductName}"></TextBox>
            <TextBlock Text="Price"></TextBlock>
            <TextBox  Name="Price" Text="{Binding PriceProduct}"></TextBox>
            <TextBlock Text="Description"></TextBlock>
            <TextBox Name="Description" Text="{Binding descriptionProduct}"></TextBox>
        </StackPanel>
        <Button Grid.Row="1"
                Command="{Binding AddNewProduct}"
                CommandParameter="{Binding ElementName=AddNewProductWindow}">Add new Product</Button>
    </Grid>
</Window>
