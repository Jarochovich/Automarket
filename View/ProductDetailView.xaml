<Window x:Class="AutoMarket.View.ProductDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        mc:Ignorable="d"
        Title="{DynamicResource Product_information}" Height="600" Width="900"
        Background="#FAFAFA"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Border Margin="20" 
            Padding="20" 
            Background="White" 
            CornerRadius="5" 
            BorderBrush="#DDD" 
            BorderThickness="1">
        <ScrollViewer>
            <StackPanel>

                <!-- Верхняя часть: Картинка слева, инфо справа -->
                <DockPanel LastChildFill="True" 
                           Margin="0,0,0,20">
                    <!-- Картинка -->
                    <Border Margin="5" 
                            Padding="25" 
                            Background="White" 
                            CornerRadius="10" 
                            BorderBrush="#DDD" 
                            BorderThickness="1">
                    <Image Source="{Binding Product.ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                           Height="250"
                           MaxWidth="250"
                           Stretch="UniformToFill"
                           Margin="0,0,20,0"
                           DockPanel.Dock="Left" />
                    </Border>
                    <!-- Информация справа от картинки -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Right" 
                                Margin="20,0,0,0">
                        <TextBlock Text="{Binding Product.Name}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#333"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{Binding Product.Price, StringFormat='Цена: {0} BYN'}"
                                   FontSize="18"
                                   FontWeight="SemiBold" 
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,20" />

                        <Button Content="{DynamicResource Add_to_cart}"
                                Width="200"
                                Height="40"
                                Cursor="Hand"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Command="{Binding AddToCartCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Описание -->
                <TextBlock Text="{DynamicResource Description}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           Margin="0,0,0,5" />

                <TextBlock Text="{Binding Product.Description}" 
                           TextWrapping="Wrap" 
                           FontSize="14"
                           Foreground="#555"
                           Margin="0,0,0,20" />

                <!-- Отзывы -->
                <TextBlock Text="{DynamicResource Reviews}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#333"
                           Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding Reviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9F9F9" 
                                    BorderBrush="#CCC" 
                                    BorderThickness="1" 
                                    CornerRadius="5"
                                    Padding="10" 
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding AuthorName}" 
                                               FontWeight="Bold" 
                                               Foreground="#1E88E5" 
                                               FontSize="14" />
                                    <TextBlock Text="{Binding Text}" 
                                               TextWrapping="Wrap" 
                                               Foreground="#555" 
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Rating, StringFormat='Оценка: {0}★'}" 
                                               Foreground="#FFB300" 
                                               FontWeight="SemiBold" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
