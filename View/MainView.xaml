<Window x:Class="AutoMarket.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket"
        xmlns:vm="clr-namespace:AutoMarket.ViewModel"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        Title="{DynamicResource MainView}" Height="500" Width="1200">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
       
    </Window.Resources>
    
    <Grid>
        <!-- Основная сетка: Header / Content / Footer -->
        <Grid.RowDefinitions>
            <!-- Filter -->
            <RowDefinition Height="60" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="40" />
            <!-- Footer -->
        </Grid.RowDefinitions>


        <!-- Внутренняя сетка контента: Sidebar и Main -->
        <Grid Grid.Row="1" 
              Grid.Column="0">
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="220" />
                <!-- Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Main -->
                <ColumnDefinition Width="*" />
                
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Border Grid.Column="0" Grid.Row="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0 0 1 0"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Padding="0 0 5 0">
                <StackPanel Grid.Column="0" 
                            Grid.Row="1"
                            Background="{DynamicResource MaterialDesignPaper}">
                    
                    <TextBlock Text="{DynamicResource Filtration}" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               FontSize="16" 
                               Margin="10"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Margin="10"
                              
                              Foreground="{DynamicResource MaterialDesignBody}"
                              materialDesign:HintAssist.Hint="Выберите категорию"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                    <ComboBox Width="150"
                              Margin="10"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              ItemsSource="{Binding Manufacturers}" 
                              SelectedItem="{Binding SelectedManufacturer}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="{DynamicResource ManufacturerHint}"/>

                    <!--Фильтр по цене (от)-->
                    <TextBox Width="150"
                             Margin="10"
                             HorizontalAlignment="Left"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Price_from}"/>

                    <!--Фильтр по цене (до)-->
                    <TextBox Width="150"
                             Margin="10,10,10,10"
                             HorizontalAlignment="Left"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Price_up_to}"/>

                    <!--Сбросить фильтры-->
                    <Button Content="{DynamicResource Reset_filter}"
                            Command="{Binding ResetFilterCommand}"
                            Margin="10"
                            Foreground="{DynamicResource MaterialDesignBody}"/>

                </StackPanel>
            </Border>



            <!-- Main content -->
            <ScrollViewer Grid.Row="1" 
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          
                          Background="{DynamicResource MaterialDesignPaper}">
                <ListView ItemsSource="{Binding Products}"
                          Background="{DynamicResource MaterialDesignPaper}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                          Cursor="Hand">

                    <!-- Отображение товаров -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="10" Margin="10" Padding="10" Background="{DynamicResource MaterialDesignPaper}" Width="320">
                                <StackPanel>
                                    <!-- Изображение товара -->
                                    <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                                           Width="280"
                                           MaxHeight="200"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                    <!-- Название товара -->
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Margin="0,0,0,5" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}"/>

                                    <!-- Производитель -->
                                    <TextBlock Text="{Binding Manufacturer.Name, StringFormat='Производитель: {0}'}"
                                               FontSize="13" 
                                               TextWrapping="Wrap" 
                                               Margin="0,0,0,5" 
                                               Foreground="{DynamicResource MaterialDesignBody}"/>

                                    <!-- Цена товара -->
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} BYN'}"
                                               FontWeight="SemiBold" 
                                               FontSize="14" 
                                               Margin="0,0,0,5" 
                                               Foreground="#2E7D32"/>

                                    <!-- Рейтинг товара -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Рейтинг: " VerticalAlignment="Center" Foreground="#555"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" Fill="Gold" Width="16" Height="16" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" Fill="Gold" Width="16" Height="16" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" Fill="Gold" Width="16" Height="16" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" Fill="Gray" Width="16" Height="16" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" Fill="Gray" Width="16" Height="16" Margin="1,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Grid для кнопок "Подробнее" и "В корзину" -->
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <!-- 2/3 -->
                                            <ColumnDefinition Width="*" />
                                            <!-- 1/3 -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Кнопка "Подробнее" -->
                                        <Button Content="Подробнее"
                                                Command="{Binding DataContext.OpenProductDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Foreground="White"
                                                Background="#fc2626"
                                                BorderBrush="#fc2626"
                                                Cursor="Hand"
                                                Padding="6,2"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Stretch"
                                                Grid.Column="0"/>

                                        <!-- Кнопка "В корзину" -->
                                        <Button 
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Foreground="White"
                                            Background="#2E7D32"
                                            BorderBrush="#2E7D32"
                                            Cursor="Hand"
                                            Margin="10 0 0 0"
                                            Padding="6,2"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Stretch"
                                            Grid.Column="1">
                                                <svg:SvgViewbox Source="pack://application:,,,/Resources/Pictures/basket3.svg" Stretch="Uniform" Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>


                </ListView>
            </ScrollViewer>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#fc2626" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Логотип -->
                <ColumnDefinition Width="*"/>
                <!-- Поисковая строка -->
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопки -->
            </Grid.ColumnDefinitions>

            <!-- Логотип -->
            <TextBlock Text="{DynamicResource Title}"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Grid.Column="0" />

            <!-- Поисковая строка: растягивается -->
            <TextBox Height="30"
                     VerticalAlignment="Center"
                     Margin="20,0"
                     Foreground="White"
                     materialDesign:ColorZoneAssist.Background="White"
                     Padding="10,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Поиск товара..."
                     Grid.Column="1" />

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0"
                        Grid.Column="2">

                <!-- Профиль -->

                <Button Command="{Binding ProfileCommand}"
                        ToolTip="Личный кабинет"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Margin="3,0">
                    <svg:SvgViewbox Source="pack://application:,,,/Resources/Pictures/profile.svg" 
                    Stretch="Uniform" 
                    Height="24" 
                    Width="24" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"/>
                </Button>

                <!-- Корзина -->
                <Button Command="{Binding CartCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Margin="3,0">
                    <svg:SvgViewbox Source="pack://application:,,,/Resources/Pictures/basket.svg" Stretch="Uniform" Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Выйти -->
                <Button Command="{Binding LogoutCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="3,0">
                    <TextBlock Text="{DynamicResource Logout}" />
                </Button>
            </StackPanel>
        </Grid>

        

        <!-- Footer -->
        <DockPanel Grid.Row="2" 
                   Background="#fc2626"
                   VerticalAlignment="Center" 
                   Height="40">
            <Button Content="🇷🇺 Русский" Command="{Binding SetRussianCommand}" Margin="5"/>
            <Button Content="🇺🇸 English" Command="{Binding SetEnglishCommand}" Margin="5"/>
            <ToggleButton x:Name="ThemeToggle"
              ToolTip="Переключить тему"
              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="WeatherNight" Width="16" Height="16"/>
                </StackPanel>
            </ToggleButton>
            <TextBlock Text="{DynamicResource Footer_text}"
                       FontSize="12" 
                       Margin="10,0" 
                       Foreground="White"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
            
        </DockPanel>
    </Grid>
</Window>
