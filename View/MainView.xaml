                    </Grid>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgViewbox 
                        Source="C:\Users\yarok\Desktop\Стасян\4_СЕМ_ЛАБЫ\AutoMarket\AM_APP\AM_APP\Pages\detail\Engine.svg"
                        Height="30" Width="30" 
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Grid.Column="0"/>

                        <TextBlock Text="БУ запчасти" 
                        VerticalAlignment="Center" 
                        FontSize="16" 
                        Style="{StaticResource CustomFont}" 
                        Margin="10,0,0,0"
                        Grid.Column="1"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgViewbox 
                        Source="C:\Users\yarok\Desktop\Стасян\4_СЕМ_ЛАБЫ\AutoMarket\AM_APP\AM_APP\Pages\detail\Wheel.svg"
                        Height="30" Width="30" 
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Grid.Column="0" Cursor=""/>

                        <TextBlock Text="Шины" 
                        VerticalAlignment="Center" 
                        FontSize="16" 
                        Style="{StaticResource CustomFont}" 
                        Margin="10,0,0,0"
                        Grid.Column="1"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowAllProductCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgViewbox 
                        Source="C:\Users\yarok\Desktop\Стасян\4_СЕМ_ЛАБЫ\AutoMarket\AM_APP\AM_APP\Pages\detail\Wheel.svg"
                        Height="30" Width="30" 
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Grid.Column="0" Cursor=""/>

                        <TextBlock Text="Все товары" 
                        VerticalAlignment="Center" 
                        FontSize="16" 
                        Style="{StaticResource CustomFont}" 
                        Margin="10,0,0,0"
                        Grid.Column="1"/>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>


        <!--MainContent-->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding Products}" ItemTemplate="{StaticResource ProductTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Чтобы элементы не растягивались, задаём стиль для ItemContainer -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="10"/>
                        <Setter Property="Width" Value="220"/>
                        <!-- ширина карточки -->
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>



    </Grid>
</Window>
