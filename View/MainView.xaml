<Window x:Class="AutoMarket.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket"
        xmlns:vm="clr-namespace:AutoMarket.ViewModel"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        Title="MainView" Height="500" Width="1200">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>


        <!--cart-Products-->
        <DataTemplate x:Key="ProductTemplate">
            <Border BorderThickness="1" BorderBrush="Gray" Margin="5">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Price, StringFormat=C}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Основная сетка: Header / Content / Footer -->
        <Grid.RowDefinitions>
            <!-- Filter -->
            <RowDefinition Height="60" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="40" />
            <!-- Footer -->
        </Grid.RowDefinitions>


        <!-- Внутренняя сетка контента: Sidebar и Main -->
        <Grid Grid.Row="1" 
              Grid.Column="0">
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="220" />
                <!-- Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Main -->
                <ColumnDefinition Width="*" />
                
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            

            <StackPanel Grid.Column="0" 
                        Grid.Row="1"
                        Background="#F2F2F2">
                <TextBlock Text="Категории" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Margin="10"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         DisplayMemberPath="Name"
                         Margin="10"/>
            </StackPanel>

            <!-- Filter -->
            <StackPanel Grid.Column="0" 
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="#F2F2F2"
                        Orientation="Horizontal">
                <TextBlock Text="Фильтрация" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Margin="10"
                           VerticalAlignment="Center"/>
                <StackPanel Margin="10, 0, 10, 0" 
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <!-- Фильтр по производителю -->
                    <ComboBox Width="150"
                              Margin="10"
                              ItemsSource="{Binding Manufacturers}" 
                              SelectedItem="{Binding SelectedManufacturer}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Производитель"/>

                    <!-- Фильтр по цене (от) -->
                    <TextBox Width="100"
                             Margin="10"
                             Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Цена от"/>

                    <!-- Фильтр по цене (до) -->
                    <TextBox Width="100"
                             Margin="10,10,10,10"
                             Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Цена до"/>

                    <!-- Кнопка применить -->
                    <Button Content="Применить фильтр"
                            Command="{Binding ApplyFilterCommand}"
                            Margin="0,10,0,10"
                            Foreground="White"/>
                    
                    <!-- Сбросить фильтры -->
                    <Button Content="Сбросить фильтр"
                            Command="{Binding ResetFilterCommand}"
                            Margin="0,10,0,10"
                            Foreground="White"/>
                </StackPanel>

            </StackPanel>


            <!-- Main content -->
            <ScrollViewer Grid.Row="1" 
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          
                          Background="#1E1E1E">
                <ListView ItemsSource="{Binding Products}"
                          Background="White"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                          Cursor="Hand">

                    <!-- Отображение товаров -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCC"
                                    BorderThickness="1"
                                    Margin="10"
                                    Padding="10"
                                    Width="220">
                                <StackPanel>
                                    <!-- Картинка -->
                                    <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                                           Width="80" 
                                           Height="60" 
                                           Margin="0,0,10,0"/>

                                    <!-- Название -->
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Bold" 
                                               FontSize="14" 
                                               Foreground="White"/>

                                    <!-- Описание -->
                                    <TextBlock Text="{Binding Description}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,5,0,0" 
                                               Foreground="White"/>

                                    <!-- Цена -->
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} BYN'}"
                                               FontWeight="SemiBold" 
                                               Margin="0,5,0,0" 
                                               Foreground="White"/>

                                    <!-- Рейтинг -->
                                    <StackPanel Orientation="Horizontal" 
                                                Margin="0,5,0,0">
                                        <TextBlock Text="Рейтинг: " 
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gray" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gray" Width="15" Height="15" Margin="1,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Кнопка "Подробнее" -->
                                    <Button Content="Подробнее"
                                            Margin="0,10,0,0"
                                            Tag="{Binding}"
                                            Click="ProductClicked"
                                            Foreground="White"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#fc2626" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Логотип -->
                <ColumnDefinition Width="*"/>
                <!-- Поисковая строка -->
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопки -->
            </Grid.ColumnDefinitions>

            <!-- Логотип -->
            <TextBlock Text="АвтоМаркет"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Grid.Column="0" />

            <!-- Поисковая строка: растягивается -->
            <TextBox Height="30"
                     VerticalAlignment="Center"
                     Margin="20,0"
                     Foreground="White"
                     materialDesign:ColorZoneAssist.Background="White"
                     Padding="10,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Поиск товара..."
                     Grid.Column="1" />

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0"
                        Grid.Column="2">

                <!-- Профиль -->
                <Button Command="{Binding ProfileCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Margin="3,0">
                    <svg:SvgViewbox Source="pack://application:,,,/Resources/Pictures/profile.svg" Stretch="Uniform" Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Корзина -->
                <Button Command="{Binding CartCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Margin="3,0">
                    <svg:SvgViewbox Source="pack://application:,,,/Resources/Pictures/basket.svg" Stretch="Uniform" Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Выйти -->
                <Button Command="{Binding LogoutCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="3,0">
                    <TextBlock Text="Выйти"/>
                </Button>

            </StackPanel>
        </Grid>

        

        <!-- Footer -->
        <DockPanel Grid.Row="2" 
                   Background="#fc2626"
                   VerticalAlignment="Center" 
                   Height="40">
            <TextBlock Text="©2025 АвтоМаркет. Все права защищены." 
                       FontSize="12" 
                       Margin="10,0" 
                       Foreground="White"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
