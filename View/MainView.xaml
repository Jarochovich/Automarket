                        </Grid.ColumnDefinitions>

                        <svg:SvgViewbox 
                        Source="C:\Users\yarok\Desktop\Стасян\4_СЕМ_ЛАБЫ\AutoMarket\AM_APP\AM_APP\Pages\detail\Disk.svg"
                        Height="30" Width="30" 
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Grid.Column="0"/>

                        <TextBlock Text="Диски" 
                        VerticalAlignment="Center" 
