<Window x:Class="AutoMarket.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket"
        xmlns:vm="clr-namespace:AutoMarket.ViewModel"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
         xmlns:converters="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        Title="MainView" Height="500" Width="1200">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>

        <CollectionViewSource x:Key="GroupedProducts"
                      Source="{Binding Products}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category.Name"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!--CustomFont-->
        <Style x:Key="CustomFont">
            <Setter Property="TextElement.FontFamily" Value="/Fonts/#Roboto" />
        </Style>

        <!--SidebarButtonStyle-->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                         BorderBrush="{TemplateBinding BorderBrush}" 
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D7FF"/>
                    <Setter Property="BorderBrush" Value="#5946D7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--cart-Products-->
        <DataTemplate x:Key="ProductTemplate">
            <Border BorderThickness="1" BorderBrush="Gray" Margin="5">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Price, StringFormat=C}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Основная сетка: Header / Content / Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="40" />
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Внутренняя сетка контента: Sidebar и Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <!-- Sidebar -->
                <ColumnDefinition Width="*" />
                <!-- Main -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <StackPanel Grid.Column="0" Background="#F2F2F2">
                <TextBlock Text="Категории" FontWeight="Bold" FontSize="16" Margin="10"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         DisplayMemberPath="Name"
                         Margin="10"/>
            </StackPanel>

            <!-- Main content -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" Background="White">
                <ListView ItemsSource="{Binding Source={StaticResource GroupedProducts}}"
              Background="White"
              BorderThickness="0"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!-- Отображение товаров -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate  >
                        <DataTemplate>
                            <Border 
                                 
                                BorderBrush="#CCC"
                                BorderThickness="1"
                                Margin="10"
                                Padding="10"
                                Width="220">
                                <StackPanel>
                                    <!-- Картинка -->
                                    <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                               Width="80" Height="60" Margin="0,0,10,0"/>

                                    <!-- Название -->
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />

                                    <!-- Описание -->
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" />

                                    <!-- Цена -->
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} BYN'}"
                                   FontWeight="SemiBold" Margin="0,5,0,0" />

                                    <!-- Рейтинг -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Рейтинг: " VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gold" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gray" Width="15" Height="15" Margin="1,0"/>
                                            <Path Data="M10,1L12,6L17,6L13,9L14,15L10,12L6,15L7,9L3,6L8,6Z" 
                                      Fill="Gray" Width="15" Height="15" Margin="1,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Кнопка "Подробнее" -->
                                    <Button Content="Подробнее"
                    Margin="0,10,0,0"
                    Tag="{Binding}"
                    Click="ProductClicked"
Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <!-- Header -->
        <DockPanel Grid.Row="0"  VerticalAlignment="Center" Height="60">
            <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                Text="АвтоМаркет"
               Foreground="White"
               FontSize="20"
               FontWeight="Bold"
               Margin="20,0"
               VerticalAlignment="Center"
               DockPanel.Dock="Left" />

            <!-- Поисковая строка -->
            <TextBox Width="250"
             Height="30"
             Margin="10,0"
             VerticalAlignment="Center"
             HorizontalAlignment="Left"
             DockPanel.Dock="Left"
             Padding="5"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             materialDesign:HintAssist.Hint="Поиск товара..." />

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,20,0"
            DockPanel.Dock="Right">
                <Button Content="Профиль"
            Width="90"
            Margin="5,0"
            Command="{Binding ProfileCommand}" />
                <Button Content="Корзина"
            Width="90"
            Margin="5,0"
            Command="{Binding CartCommand}" />
                <Button Content="Выйти"
            Width="90"
            Margin="5,0"
            Command="{Binding LogoutCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Background="#E0E0E0" VerticalAlignment="Center" Height="40">
            <TextBlock Text="©2025 АвтоМаркет. Все права защищены." 
                       FontSize="12" Margin="10,0" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
