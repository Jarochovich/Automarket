<Window x:Class="AutoMarket.View.AccountView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Личный кабинет" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToStarColorConverter x:Key="BoolToStarColorConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToTextReviewConverter x:Key="BoolToTextReviewConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#fc2626" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Account_PersonalCabinet}" 
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" Padding="20" Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel>
                <TabControl>
                    <!-- Информация о пользователе -->
                    <TabItem Header="{DynamicResource Account_PersonalInfo}">
                        <materialDesign:Card 
                    Margin="0 0 0 20" 
                    Padding="15"
                    Background="{DynamicResource MaterialDesignPaper}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Account_PersonalInfo}" 
                                   FontSize="18"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{DynamicResource Account_Login}" Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource MaterialDesignBody}" Margin="0 0 10 5" FontSize="16"/>
                                    <TextBlock Text="{Binding CurrentUser.Login}" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource MaterialDesignBody}" Margin="0 0 0 5" Grid.ColumnSpan="2"/>

                                    <TextBlock Text="{DynamicResource Account_Phone}" Grid.Row="1" Grid.Column="0"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="0 0 10 5" FontSize="16"/>
                                    <TextBlock Text="{Binding CurrentUser.PhoneNumber}" Foreground="{DynamicResource MaterialDesignBody}" Grid.Row="1" Grid.Column="1" Margin="0 0 0 5" Grid.ColumnSpan="2"/>

                                    <TextBlock Text="{DynamicResource Account_Balance}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="0 0 10 5" FontSize="16"/>
                                    <StackPanel Grid.Row="2" 
                                                Grid.Column="1" 
                                                Orientation="Horizontal"
                                                Grid.ColumnSpan="1" 
                                                Margin="0" 
                                                Grid.RowSpan="1" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUser.Balance, StringFormat='{}{0} BYN'}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesignBody}" 
                                                   Margin="0 0 10 5"/>
                                        <Button Content="{DynamicResource Account_TopUpBalance}" VerticalAlignment="Center" 
                                                Command="{Binding TopUpBalanceCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Padding="5 2"
                                                />
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Account_Settings}" 
                                               Grid.Row="3" 
                                   FontSize="18"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   FontWeight="Bold"
                                   Margin="0 10 0 10"/>


                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0 10 0 0">


                                        <TextBlock Text="{DynamicResource Account_Language}" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" Margin="0 0 10 0" FontSize="16"/>
                                        <Button Content="🇷🇺 Русский"  
            Command="{Binding SetRussianCommand}" 
            Margin="5 0"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Padding="5 2"/>
                                        <Button Content="🇺🇸 English" 
            Command="{Binding SetEnglishCommand}" 
            Margin="5 0"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Padding="5 2"/>

                                        <TextBlock Text="{DynamicResource Account_Theme}" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" Margin="15 0 10 0" FontSize="16"/>
                                        <ToggleButton x:Name="ThemeToggle" FontSize="16"
ToolTip="Переключить тему"
IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
Command="{Binding ToggleThemeCommand}"
Margin="0 0 20 0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="WeatherNight" Width="16" Height="16"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>


                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </TabItem>


                    <!-- Новая вкладка для управления заказами -->
                    <TabItem Header="{DynamicResource Account_MyOrders}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Ожидающие подтверждения -->
                            <GroupBox Grid.Row="0" Header="{DynamicResource Account_PendingConfirmation}" Margin="5"
                 >
                                <ListView ItemsSource="{Binding PendingPurchases}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource Account_Product}" DisplayMemberBinding="{Binding ProductName}"/>
                                            <GridViewColumn Header="{DynamicResource Account_Quantity}" DisplayMemberBinding="{Binding Purchase.Quantity}"/>
                                            <GridViewColumn Header="{DynamicResource Account_Amount}" DisplayMemberBinding="{Binding TotalPrice, StringFormat={}{0} BYN}"/>
                                            <GridViewColumn Header="{DynamicResource Account_Actions}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{DynamicResource Account_Take}"
                                                                    Foreground="{DynamicResource MaterialDesignBody}"
                                                                    Margin="0 0 10 0"
                                                                    Command="{Binding DataContext.ConfirmPurchaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource Account_Cancel}"
                                                                    Foreground="{DynamicResource MaterialDesignBody}"
                                                                    Command="{Binding DataContext.CancelPurchaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>

                            <!-- История покупок (только подтвержденные) -->
                            <materialDesign:Card Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}">
                                <!-- существующая разметка истории покупок -->
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>


                    <TabItem Header="{DynamicResource Account_PurchaseArchive}">
                        <!-- История покупок -->
                        <materialDesign:Card Background="{DynamicResource MaterialDesignPaper}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Account_PurchaseHistory}" 
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="10"/>

                                <ListView ItemsSource="{Binding ConfirmedPurchases}"
                                  Height="Auto"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border  BorderThickness="0 0 0 1" Padding="10" Margin="5"
                                            CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}" 
                                            >
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="3*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Изображение -->
                                                    <Image Source="{Binding Product.ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                                                   Width="150" Height="150"
                                                   Grid.Column="0"
                                                   Margin="0 0 10 0"/>

                                                    <!-- Информация о товаре -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <TextBlock 
                                                    Text="{Binding Product.Name}" 
                                                    FontWeight="Bold" 
                                                    Foreground="{DynamicResource MaterialDesignBody}"
                                                    FontSize="16"/>
                                                        <TextBlock 
                                                    Text="{Binding Product.Manufacturer.Name}" 
                                                    FontSize="12" 
                                                    Foreground="{DynamicResource MaterialDesignBody}" 
                                                    Margin="0 5 0 0"/>
                                                        <TextBlock 
                                                    Text="{Binding Product.Price, StringFormat='Цена: {0} BYN'}"
                                                    Foreground="{DynamicResource MaterialDesignBody}"
                                                    FontWeight="SemiBold"/>
                                                        <TextBlock 
                                                    Text="{Binding Purchase.Quantity, StringFormat='Количество: {0}'}"
                                                    Foreground="{DynamicResource MaterialDesignBody}" />

                                                        <TextBlock 
                                                            Text="{Binding Purchase.PurchaseDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                Foreground="{DynamicResource MaterialDesignBody}"/>

                                                    </StackPanel>

                                                    <!-- Отзыв и рейтинг -->
                                                    <StackPanel Grid.Column="2" Margin="10 0 0 10">
                                                        <TextBlock Text="{DynamicResource Account_RateProduct}" FontWeight="Bold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ItemsControl ItemsSource="{Binding Stars}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="★"
                                                                        Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding Value}"
                                                                        FontSize="24"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="{Binding IsFilled, Converter={StaticResource BoolToStarColorConverter}}"
                                                                        Cursor="Hand" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <TextBox Margin="0 10 0 0"
                                                         Height="50"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         materialDesign:HintAssist.Hint="{DynamicResource Account_YourReview}"/>

                                                        <Button Content="{Binding HasUserReviewed, Converter={StaticResource BoolToTextReviewConverter}}"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Margin="0 10 0 0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Padding="8 4"
                                                        Command="{Binding DataContext.SubmitReviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"    
                                                        IsEnabled="{Binding HasUserReviewed, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </materialDesign:Card>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#fc2626" Padding="10">
            <Button Content="{DynamicResource Account_BackToShop}"
                    Foreground="AliceBlue"
                    Command="{Binding BackToMainCommand}"
                    HorizontalAlignment="Center"
                    />
        </Border>
    </Grid>
</Window>