<Window x:Class="AutoMarket.View.AccountView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Личный кабинет" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#fc2626" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Личный кабинет" 
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel>
                <!-- Информация о пользователе -->
                <materialDesign:Card Margin="0 0 0 20" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Персональная информация" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Логин:" Grid.Row="0" Grid.Column="0" Margin="0 0 10 5"/>
                            <TextBlock Text="{Binding CurrentUser.Login}" Grid.Row="0" Grid.Column="1" Margin="0 0 0 5"/>

                            <TextBlock Text="Телефон:" Grid.Row="1" Grid.Column="0" Margin="0 0 10 5"/>
                            <TextBlock Text="{Binding CurrentUser.PhoneNumber}" Grid.Row="1" Grid.Column="1" Margin="0 0 0 5"/>

                            <Button Content="Редактировать профиль" 
                                    Grid.Row="2" Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Margin="0 10 0 0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="10 5"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- История покупок -->
                <materialDesign:Card>
                    <StackPanel>
                        <TextBlock Text="История покупок" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="10"/>

                        <ListView ItemsSource="{Binding PurchasedProducts}" 
                                  Height="300"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0 0 0 1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageConverter}}"
                                                   Width="80" Height="80"
                                                   Grid.Column="0"
                                                   Margin="0 0 10 0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Manufacturer.Name}" Margin="0 5 0 0"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Price, StringFormat='{}{0} BYN'}" 
                                                       Grid.Column="2"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#f5f5f5" Padding="10">
            <Button Content="Вернуться в магазин"
                    Command="{Binding BackToMainCommand}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </Border>
    </Grid>
</Window>