<Window x:Class="AutoMarket.View.RegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        xmlns:helpers="clr-namespace:AutoMarket.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:AutoMarket.Helpers"
        Title="{DynamicResource RegisterButton}" Height="500" Width="800">

    <Window.Resources>
        <converters:PhoneNumberFormatter x:Key="PhoneNumberFormatter" />

        <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Text="{Binding [0].ErrorContent}" 
                                           Foreground="Red"
                                           Margin="0 4 0 0"
                                           FontSize="12"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    
    
    
    
    <Grid Background="#ffdadada">
        <Border MinWidth="250" Margin="20" Padding="20" Background="#ffffffff" VerticalAlignment="Center" MaxWidth="600" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="LightGray"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{DynamicResource GreetingText}" FontSize="20" FontWeight="Bold" Margin="0 0 0 30"/>

                <Grid Margin="0 0 0 20">
                    <Button Content="{DynamicResource RegisterButton}" 
                            HorizontalAlignment="Left"/>
                    <Button Content="{DynamicResource LoginButton}" 
                            HorizontalAlignment="Right" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ShowAuthCommand}"/>
                </Grid>

                <TextBox x:Name="LoginBox" 
                          Margin="0 10"
         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
         materialDesign:HintAssist.Hint="{DynamicResource LoginHint}" 
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <!-- Удалите кастомные ErrorTemplate из PasswordBox -->
                <PasswordBox x:Name="FirstPassBox" 
                             Margin="0 10"
                 helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, ValidatesOnDataErrors=True}"
                 materialDesign:HintAssist.Hint="{DynamicResource PasswordHint}"
                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>

                <PasswordBox x:Name="SecondPassBox"
                             Margin="0 10"
                 helpers:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, ValidatesOnDataErrors=True}"
                 materialDesign:HintAssist.Hint="{DynamicResource ConfirmPasswordHint}"
                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>

                <TextBox x:Name="PhoneBox"
                         Margin="0 10"
         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={StaticResource PhoneNumberFormatter}}"
         materialDesign:HintAssist.Hint="{DynamicResource PhoneNumberHint}" 
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <Button Margin="0 20"
                        Content="{DynamicResource RegisterButton}"
                        Command="{Binding RegisterCommand}"
                          />
            </StackPanel>
        </Border>
    </Grid>
</Window>
