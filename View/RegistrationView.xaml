<Window x:Class="AutoMarket.View.RegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация" Height="450" Width="800">
    <Grid Background="#ffdadada">
        <Border MinWidth="250" Margin="20" Padding="20" Background="#ffffffff" VerticalAlignment="Center" MaxWidth="600" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="LightGray"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Здравствуйте!" FontSize="20" FontWeight="Bold" Margin="0 0 0 30"/>
                
                <Grid Margin="0 0 0 30">
                    <Button Content="Регистрация" 
                            HorizontalAlignment="Left"/>
                    <Button Content="Войти" 
                            HorizontalAlignment="Right" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ShowAuthCommand}"/>
                </Grid>

                <TextBox x:Name="LoginBox" 
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         materialDesign:HintAssist.Hint="Введите логин" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         />
                <PasswordBox x:Name="FirstPassBox" 
                             PasswordChanged="FirstPassBox_PasswordChanged"
                             materialDesign:HintAssist.Hint="Введите пароль" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>
                <PasswordBox x:Name="SecondPassBox"
                             PasswordChanged="SecondPassBox_PasswordChanged"
                             materialDesign:HintAssist.Hint="Повторите пароль" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>
                <TextBox x:Name="PhoneBox"
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         materialDesign:HintAssist.Hint="Номер телефона" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                
                <Button Margin="0 20" 
                        Content='Зарегистрироваться'
                        Command="{Binding RegisterCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
