<Window x:Class="AutoMarket.View.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMarket.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource AdminPanel}" Height="450" Width="800">

    <Window.Resources>

        <CollectionViewSource x:Key="GroupedProducts"
                              Source="{Binding Products}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category.Name"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!--CustomFont-->
        <Style x:Key="CustomFont">
            <Setter Property="TextElement.FontFamily" Value="/Fonts/#Roboto" />
        </Style>

       

        <!--cart-Products-->
        <DataTemplate x:Key="ProductTemplate">
            <Border BorderThickness="1" BorderBrush="Gray" Margin="5">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Price, StringFormat=C}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Основная сетка: Header / Content / Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="40" />
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Внутренняя сетка контента: Sidebar и Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <ColumnDefinition Width="*" />
                <!-- Main -->
            </Grid.ColumnDefinitions>


            <!-- Main content -->
            <ScrollViewer Grid.Row="1" Foreground="White"
                      Grid.Column="1" 
                      Background="#1E1E1E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0" SelectedItem="{Binding SelectedTabItem}">
                        <!-- USERS TAB -->
                        <TabItem Name="UsersTab">
                            <TabItem.Header>
                                <TextBlock Text="Users" Foreground="white"/>
                            </TabItem.Header>
                            <TabItem.ContextMenu>
                                <ContextMenu Foreground="#fc2626" Background="#1E1E1E">
                                    <MenuItem Foreground="white" Header="{DynamicResource Edit}" Command="{Binding OpenEditItem}"/>
                                    <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteItem}"/>
                                </ContextMenu>
                            </TabItem.ContextMenu>

                            <DataGrid Name="ViewAllUsers"
                                      ItemsSource="{Binding AllUsers}"
                                      SelectedItem="{Binding SelectedUser}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Foreground="White"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#1E1E1E"
                                      BorderBrush="#3A3A3A"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="Login" Binding="{Binding Login}" />
                                    <DataGridTextColumn Header="Password" Binding="{Binding PasswordHash}" />
                                    <DataGridTextColumn Header="PhoneNumber" Binding="{Binding PhoneNumber}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- PRODUCTS TAB -->
                        <TabItem Name="ProductsTab">
                            <TabItem.Header>
                                <TextBlock Text="Product" Foreground="white"/>
                            </TabItem.Header>
                            <TabItem.ContextMenu>
                                <ContextMenu Foreground="#fc2626" Background="#1E1E1E">
                                    <MenuItem Foreground="white" Header="{DynamicResource Edit}" Command="{Binding OpenEditItem}"/>
                                    <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteItem}"/>
                                </ContextMenu>
                            </TabItem.ContextMenu>

                            <DataGrid Name="ViewAllProducts"
                                      ItemsSource="{Binding AllProducts}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Foreground="White"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#1E1E1E"
                                      BorderBrush="#3A3A3A"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryId}" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- CATEGORIES TAB -->
                        <TabItem Name="CategoriesTab">
                            <TabItem.Header>
                                <TextBlock Text="Categories" 
                                           Foreground="white"/>
                            </TabItem.Header>
                            <TabItem.ContextMenu>
                                <ContextMenu Foreground="#fc2626" Background="#1E1E1E">
                                    <MenuItem Foreground="white" Header="{DynamicResource Edit}" Command="{Binding OpenEditItem}"/>
                                    <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteItem}"/>
                                </ContextMenu>
                            </TabItem.ContextMenu>

                            <DataGrid Name="ViewAllCategories"
                                      ItemsSource="{Binding AllCategories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Foreground="White"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#1E1E1E"
                                      BorderBrush="#3A3A3A"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CategoryId" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Name}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>


                        <!-- Manufacturers TAB -->
                        <TabItem Name="ManufacturersTab">
                            <TabItem.Header>
                                <TextBlock Text="Manufacturers" Foreground="white"/>
                            </TabItem.Header>
                            <TabItem.ContextMenu>
                                <ContextMenu Foreground="#fc2626" Background="#1E1E1E">
                                    <MenuItem Foreground="white" Header="{DynamicResource Edit}" Command="{Binding OpenEditItem}"/>
                                    <MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteItem}"/>
                                </ContextMenu>
                            </TabItem.ContextMenu>

                            <DataGrid Name="ViewAllManufacturers"
                                      ItemsSource="{Binding AllManufacturers}"
                                      SelectedItem="{Binding SelectedManufacturer}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Foreground="White"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#1E1E1E"
                                      BorderBrush="#3A3A3A"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ManufacturerId" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Name}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    




                    </TabControl>
                    
                    
                    
                    
                    
                    
                    

                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <!--<Button Content="Добавить новую категорию" Command="{Binding OpenAddNewCategory}" />-->
                        <Button Content="{DynamicResource Add_new_product}" Command="{Binding OpenAddNewProduct}"/>
                        <!--<Button Content="Добавить нового пользователя" Command="{Binding OpenAddNewUser}"/>-->
                    </StackPanel>



                </Grid>


            </ScrollViewer>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#fc2626" Height="60">
            <Grid.ColumnDefinitions>
                <!-- Логотип -->
                <ColumnDefinition Width="Auto"/>
                
                <ColumnDefinition Width="*"/>
                <!-- Кнопки -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип -->
            <TextBlock Text="{DynamicResource Title}"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Grid.Column="0" />

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0"
                        Grid.Column="2">

                <!-- Выйти -->
                <Button Command="{Binding LogoutCommand}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    Cursor="Hand"
                    Margin="3,0">
                    <TextBlock Text="{DynamicResource Logout}"/>
                </Button>

            </StackPanel>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" 
               Background="#fc2626"
               VerticalAlignment="Center" 
               Height="40">
            <Button Content="🇷🇺 Русский" Command="{Binding SetRussianCommand}" Margin="5"/>
            <Button Content="🇺🇸 English" Command="{Binding SetEnglishCommand}" Margin="5"/>
            <TextBlock Text="{DynamicResource Footer_text}" 
                   FontSize="12" 
                   Margin="10,0" 
                   Foreground="White"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"/>
        </DockPanel>
    </Grid>

    
</Window>
